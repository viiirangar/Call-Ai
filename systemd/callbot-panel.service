[Unit]
Description=My French Assistant - Panel (Next.js, port 4000)
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/callbot/panel
ExecStart=/usr/bin/npm run start:4000
Restart=always
RestartSec=5
Environment=NODE_ENV=production
MemoryMax=1200M

[Install]
WantedBy=multi-user.target
